# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA
qa-reports/artifacts/

# Evidencias de presentación: capturas, vídeos e informes pesados (se conservan en local)
presentation-review/**/capturas/
presentation-review/**/grabaciones/
presentation-review/**/comparativa/
presentation-review/**/lighthouse/

# Originales de trabajo de la reproducción de Los elefantes (ver CREDITOS.md)
assets-source/elefantes-referencia/*.png

# Basquiat: el original de la reproducción de referencia no entra en Git; la copia web
# (public/obras/basquiat-untitled-referencia.jpg) se publica por decisión editorial (28/10/2026)
assets-source/basquiat-referencia/*.jpg

# Glenn (Basquiat): ídem; no entra en Git
assets-source/glenn-referencia/*.jpg

# Capturas sueltas de QA: se conservan en local; en Git solo informes y herramientas
presentation-review/**/*.jpg
presentation-review/**/*.png

# Tema de Shopify generado (npm run shopify:empaquetar)
/shopify-tema/
